# Feu una còpia d'aquest fitxer amb nom .env, amb les dades de la connexió i no el pugeu al repositori (per seguretat)
# Configuració per a MongoDB. 
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bdnr

# Configuració per a Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Activa/desactiva cada base de dades (true/false)
USE_MONGODB=true
USE_NEO4J=false
